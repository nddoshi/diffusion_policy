<!--
  Box Touch Scene: Franka Panda robot with point end-effector on a table with a box.
  The goal is to touch the top surface of the box with the end-effector.
  
  The Franka arm has 7 DOF with position actuators. No gripper — just a small
  sphere at the end-effector site.
-->
<mujoco model="box_touch">
    <compiler angle="radian"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>
    <size njmax="500" nconmax="500" nuser_actuator="5"/>

    <visual>
        <global offwidth="640" offheight="480"/>
        <quality shadowsize="4096" offsamples="8"/>
        <map force="0.1" fogend="5"/>
    </visual>

    <asset>
        <!-- Franka mesh files (visual) -->
        <mesh name="link0_viz" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/visual/link0.stl"/>
        <mesh name="link1_viz" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/visual/link1.stl"/>
        <mesh name="link2_viz" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/visual/link2.stl"/>
        <mesh name="link3_viz" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/visual/link3.stl"/>
        <mesh name="link4_viz" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/visual/link4.stl"/>
        <mesh name="link5_viz" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/visual/link5.stl"/>
        <mesh name="link6_viz" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/visual/link6.stl"/>
        <mesh name="link7_viz" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/visual/link7.stl"/>

        <!-- Franka mesh files (collision) -->
        <mesh name="link0_col" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/collision/link0.stl"/>
        <mesh name="link1_col" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/collision/link1.stl"/>
        <mesh name="link2_col" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/collision/link2.stl"/>
        <mesh name="link3_col" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/collision/link3.stl"/>
        <mesh name="link4_col" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/collision/link4.stl"/>
        <mesh name="link5_col" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/collision/link5.stl"/>
        <mesh name="link6_col" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/collision/link6.stl"/>
        <mesh name="link7_col" file="../../kitchen/relay_policy_learning/third_party/franka/meshes/collision/link7.stl"/>

        <!-- Textures and materials -->
        <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512"/>
        <material name="MatPlane" reflectance="0.05" texture="texplane" texrepeat="4 4" texuniform="true"/>
        <material name="table_mat" rgba="0.6 0.4 0.2 1"/>
        <material name="box_mat" rgba="0.8 0.2 0.2 1"/>
        <material name="ee_mat" rgba="0.2 0.8 0.2 1"/>
    </asset>

    <default>
        <default class="panda">
            <joint pos="0 0 0" axis="0 0 1" limited="true"/>
            <position forcelimited="true" ctrllimited="true" user="1002 40 2001 -0.005 0.005"/>
            <default class="panda_viz">
                <geom contype="0" conaffinity="0" group="0" type="mesh" rgba=".95 .99 .92 1" mass="0"/>
            </default>
            <default class="panda_col">
                <geom contype="1" conaffinity="1" group="3" type="mesh" rgba=".5 .6 .7 1"/>
            </default>
            <default class="panda_arm">
                <joint damping="100"/>
            </default>
            <default class="panda_forearm">
                <joint damping="10"/>
            </default>
        </default>
    </default>

    <worldbody>
        <!-- Lighting -->
        <light directional="true" diffuse=".4 .4 .4" specular="0.3 0.3 0.3" pos="-1 -1 3" dir="1 1 -1"/>
        <light directional="true" diffuse=".4 .4 .4" specular="0.3 0.3 0.3" pos="1 -1 3" dir="-1 1 -1"/>
        <light directional="true" diffuse=".3 .3 .3" specular="0.3 0.3 0.3" pos="0 1 3" dir="0 -1 -1"/>

        <!-- Floor -->
        <geom name="floor" pos="0 0 0" size="3 3 .1" type="plane" material="MatPlane" conaffinity="1" contype="1" condim="3"/>

        <!-- Table -->
        <body name="table" pos="0.5 0 0.4">
            <geom name="table_top" type="box" size="0.4 0.4 0.02" pos="0 0 0" rgba="0.6 0.4 0.2 1" conaffinity="1" contype="1"/>
            <!-- Table legs -->
            <geom name="leg1" type="cylinder" size="0.03 0.19" pos="0.35 0.35 -0.21" rgba="0.5 0.3 0.15 1"/>
            <geom name="leg2" type="cylinder" size="0.03 0.19" pos="-0.35 0.35 -0.21" rgba="0.5 0.3 0.15 1"/>
            <geom name="leg3" type="cylinder" size="0.03 0.19" pos="0.35 -0.35 -0.21" rgba="0.5 0.3 0.15 1"/>
            <geom name="leg4" type="cylinder" size="0.03 0.19" pos="-0.35 -0.35 -0.21" rgba="0.5 0.3 0.15 1"/>
        </body>

        <!-- Target box on the table (position and size will be randomized programmatically) -->
        <body name="target_box" pos="0.5 0.0 0.47">
            <geom name="target_box_geom" type="box" size="0.04 0.04 0.04" rgba="0.8 0.2 0.2 1" 
                  conaffinity="1" contype="1" mass="0.5"/>
            <!-- Site on top of the box for reward computation -->
            <site name="box_top" pos="0 0 0.04" size="0.005" rgba="1 0 0 0.5"/>
        </body>

        <!-- Franka Panda Robot (mounted on the floor, reaching up to the table) -->
        <body name="panda_base" pos="0 0 0">
            <!-- Base pedestal -->
            <geom type="cylinder" size="0.08 0.20" pos="0 0 0.20" rgba="0.3 0.3 0.3 1" contype="1" conaffinity="1"/>

            <!-- Franka arm chain (from chain0.xml, without gripper, with point EE) -->
            <body name="panda0_link0" pos="0 0 0.4" childclass="panda">
                <geom class="panda_viz" mesh="link0_viz"/>
                <geom class="panda_col" mesh="link0_col" mass="2.91242"/>
                <body name="panda0_link1" pos="0 0 0.333">
                    <joint name="panda0_joint1" range="-2.8973 2.8973" class="panda_arm"/>
                    <geom class="panda_viz" mesh="link1_viz"/>
                    <geom class="panda_col" mesh="link1_col" mass="2.7063"/>
                    <body name="panda0_link2" pos="0 0 0" quat="0.707107 -0.707107 0 0">
                        <joint name="panda0_joint2" range="-1.7628 1.7628" class="panda_arm"/>
                        <geom class="panda_viz" mesh="link2_viz"/>
                        <geom class="panda_col" mesh="link2_col" mass="2.73046"/>
                        <body name="panda0_link3" pos="0 -0.316 0" quat="0.707107 0.707107 0 0">
                            <joint name="panda0_joint3" range="-2.8973 2.8973" class="panda_arm"/>
                            <geom class="panda_viz" mesh="link3_viz"/>
                            <geom class="panda_col" mesh="link3_col" mass="2.04104"/>
                            <body name="panda0_link4" pos="0.0825 0 0" quat="0.707107 0.707107 0 0">
                                <joint name="panda0_joint4" range="-3.0718 -0.4" class="panda_arm"/>
                                <geom class="panda_viz" mesh="link4_viz"/>
                                <geom class="panda_col" mesh="link4_col" mass="2.08129"/>
                                <body name="panda0_link5" pos="-0.0825 0.384 0" quat="0.707107 -0.707107 0 0">
                                    <joint name="panda0_joint5" range="-2.8973 2.8973" class="panda_forearm"/>
                                    <geom class="panda_viz" mesh="link5_viz"/>
                                    <geom class="panda_col" mesh="link5_col" mass="3.00049"/>
                                    <body name="panda0_link6" pos="0 0 0" euler="1.57 0 1.57">
                                        <joint name="panda0_joint6" range="-1.6573 2.1127" class="panda_forearm"/>
                                        <geom class="panda_viz" mesh="link6_viz"/>
                                        <geom class="panda_col" mesh="link6_col" mass="1.3235"/>
                                        <body name="panda0_link7" pos="0.088 0 0" euler="1.57 0 0.7854">
                                            <joint name="panda0_joint7" range="-2.8973 2.8973" class="panda_forearm"/>
                                            <geom class="panda_viz" mesh="link7_viz"/>
                                            <geom class="panda_col" mesh="link7_col" mass="0.2"/>
                                            <!-- Point end-effector (small sphere instead of gripper) -->
                                            <body name="end_effector" pos="0 0 0.107">
                                                <geom name="ee_sphere" type="sphere" size="0.02" rgba="0.2 0.8 0.2 1" 
                                                      mass="0.1" contype="1" conaffinity="1"/>
                                                <site name="end_effector" pos="0 0 0" size="0.02" rgba="0 1 0 0.5"/>
                                            </body>
                                        </body>
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>

        <!-- Cameras -->
        <camera name="front_camera" pos="1.5 0 1.0" xyaxes="0 1 0 -0.5 0 0.866" fovy="60"/>
        <camera name="side_camera" pos="0.5 -1.5 1.0" xyaxes="1 0 0 0 0.5 0.866" fovy="60"/>
        <camera name="top_camera" pos="0.5 0 2.0" xyaxes="1 0 0 0 1 0" fovy="60"/>
    </worldbody>

    <!-- Position actuators for the 7 arm joints -->
    <actuator>
        <position name="panda0_joint1" joint="panda0_joint1" class="panda" kp="870" forcerange="-87 87" ctrlrange="-2.8973 2.8973"/>
        <position name="panda0_joint2" joint="panda0_joint2" class="panda" kp="870" forcerange="-87 87" ctrlrange="-1.7628 1.7628"/>
        <position name="panda0_joint3" joint="panda0_joint3" class="panda" kp="870" forcerange="-87 87" ctrlrange="-2.8973 2.8973"/>
        <position name="panda0_joint4" joint="panda0_joint4" class="panda" kp="870" forcerange="-87 87" ctrlrange="-3.0718 -0.4"/>
        <position name="panda0_joint5" joint="panda0_joint5" class="panda" kp="120" forcerange="-12 12" ctrlrange="-2.8973 2.8973"/>
        <position name="panda0_joint6" joint="panda0_joint6" class="panda" kp="120" forcerange="-12 12" ctrlrange="-1.6573 2.1127"/>
        <position name="panda0_joint7" joint="panda0_joint7" class="panda" kp="120" forcerange="-12 12" ctrlrange="-2.8973 2.8973"/>
    </actuator>

    <!-- Contact pair for detecting end-effector touching the box -->
    <contact>
        <pair geom1="ee_sphere" geom2="target_box_geom"/>
    </contact>

    <!-- Keyframe: default arm configuration (reaching forward) -->
    <keyframe>
        <key name="home" qpos="0.0 -0.785 0.0 -2.356 0.0 1.571 0.785"/>
    </keyframe>

</mujoco>
